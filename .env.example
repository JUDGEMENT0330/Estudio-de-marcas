# ======================================================================
# Estudio de Marcas · Cyber Valtorix — Variables de entorno
# Copia este archivo a .env.local (local) o cárgalas en Vercel
# (Project → Settings → Environment Variables).
# ======================================================================

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Estudio de Marcas

# Protección por contraseña (MUY recomendada en Vercel: la URL es pública).
# Si se define, toda la app pide usuario/contraseña (excepto /r/* y /api/health).
APP_USERNAME=
APP_PASSWORD=

# La app no se indexa en buscadores (robots.txt + X-Robots-Tag noindex).
# ALLOW_INDEXING=true lo desactiva.

# ── Almacenamiento ────────────────────────────────────────────────────
# Prioridad: MySQL (hosting) → Redis/KV → SQLite.
#
# MySQL de tu hosting de Hostinger (recomendado). En hPanel: Bases de datos →
# Administración de MySQL (crear base y usuario) y Bases de datos → MySQL remoto
# (permitir "Cualquier host" para que Vercel pueda conectarse).
# Codifica caracteres especiales de la clave en la URL (# → %23, @ → %40).
DATABASE_URL=
# Ejemplo: DATABASE_URL=mysql://u123456789_estudio:CLAVE@srv1234.hstgr.io:3306/u123456789_estudio
# Alternativa con variables sueltas:
# MYSQL_HOST=srv1234.hstgr.io
# MYSQL_PORT=3306
# MYSQL_USER=u123456789_estudio
# MYSQL_PASSWORD=
# MYSQL_DATABASE=u123456789_estudio
# MYSQL_SSL=false
# MYSQL_CONNECTION_LIMIT=3
#
# Local sin MySQL: SQLite en ./data (no requiere nada).
# Vercel: conecta "Upstash for Redis" desde el Marketplace de Vercel; crea
# automáticamente KV_REST_API_URL y KV_REST_API_TOKEN. Sin esto, en Vercel los
# reportes viven en /tmp y se pierden al reiniciarse la función.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (Equivalentes aceptados: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
# KV_PREFIX=edm
# Forzar un backend concreto (mysql | kv | sqlite):
# STORAGE_BACKEND=sqlite

# Llave para cifrar las API keys guardadas desde Configuración (64 hex).
# Genera una con: openssl rand -hex 32   (recomendada en Vercel)
APP_ENCRYPTION_KEY=

# ── Fuentes de datos ──────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_CRUX_API_KEY=
CENSUS_API_KEY=
OPENCORPORATES_API_TOKEN=
YELP_API_KEY=

# Región e idioma de Google Places (autocompletado y búsquedas)
# "sv", "sv,gt,hn" o "all" para todo el mundo
PLACES_COUNTRY=sv
PLACES_LANGUAGE=es

# ── Inteligencia artificial ───────────────────────────────────────────
# anthropic | openai | google
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
# Opcional: fija un modelo de Gemini. Vacío = "gemini-flash-latest" (siempre el Flash vigente).
# Si Google retira el modelo, la app cambia sola al que Google sugiere.
GOOGLE_AI_MODEL=
# Idioma de los textos redactados por la IA (es | en)
REPORT_LANGUAGE=es

# ── Identidad de marca de los documentos (valores por defecto) ────────
BRAND_COMPANY=CYBER VALTORIX SAS. DE C.V.
BRAND_COMPANY_SHORT=Cyber Valtorix
BRAND_EMAIL=alexmancia@cybervaltorix.com
BRAND_PHONE=7803 9807
BRAND_WEBSITE=https://cybervaltorix.com
BRAND_SIGNER=MDSc BORIS ALEXANDER RODRÍGUEZ MANCÍA
BRAND_SIGNER_ROLE=GERENTE

# Firma y sello (privado: NUNCA lo subas al repositorio público).
# Local: coloca el archivo en private/firma-sello.png (ignorado por git).
# Vercel: pega el PNG en base64 (base64 -w0 firma-sello.png).
BRAND_SIGNATURE_BASE64=
# BRAND_SIGNATURE_PATH=/ruta/a/firma-sello.png
